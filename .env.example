# Neon PostgreSQL connection: portal server only. Never use NEXT_PUBLIC_.
DATABASE_URL=
# Enable only while reviewing the seeded demo logins.
ACIES_ALLOW_DEMO_ACCOUNTS=false
ACIES_PORTAL_URL=http://127.0.0.1:3001
ACIES_SITE_URL=http://127.0.0.1:3000
ACIES_BRIDGE_SECRET=
ACIES_VERIFICATION_SECRET=
# Production: twilio. Local testing requires BOTH settings below and loopback URLs.
ACIES_OTP_MODE=twilio
ACIES_ALLOW_LOCAL_VERIFICATION=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Fallback storage when DATABASE_URL is empty: persistent private disk or Supabase.
ACIES_STORAGE_DIRECTORY=
ACIES_SUPABASE_URL=
ACIES_SUPABASE_SERVICE_ROLE_KEY=
ACIES_MEDIA_BUCKET=acies-private
