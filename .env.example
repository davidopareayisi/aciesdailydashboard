# Neon PostgreSQL connection: portal server only. Never use NEXT_PUBLIC_.
DATABASE_URL=
# Enable only while reviewing the seeded demo logins.
ACIES_ALLOW_DEMO_ACCOUNTS=false
ACIES_PORTAL_URL=http://127.0.0.1:3001
ACIES_SITE_URL=http://127.0.0.1:3000
ACIES_BRIDGE_SECRET=
ACIES_VERIFICATION_SECRET=
# Production: mnotify (or twilio). Local testing requires local mode, the flag and loopback URLs.
ACIES_OTP_MODE=mnotify
ACIES_ALLOW_LOCAL_VERIFICATION=false
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=AciesBms
# Optional alternative when ACIES_OTP_MODE=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Fallback storage when DATABASE_URL is empty: persistent private disk or Supabase.
ACIES_STORAGE_DIRECTORY=
ACIES_SUPABASE_URL=
ACIES_SUPABASE_SERVICE_ROLE_KEY=
ACIES_MEDIA_BUCKET=acies-private
# New file uploads: database (existing storage) or private Cloudflare R2.
ACIES_MEDIA_STORAGE=database
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
